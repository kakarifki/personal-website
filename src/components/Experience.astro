---
import ExperienceCard from './ExperienceCard.astro';
import { SITE_CONFIG } from '../data/config';
const { experience } = SITE_CONFIG;
---

<section id="experience" class="py-24 relative bg-slate-950">
  <div class="container mx-auto px-4">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white" set:html={experience.title}></h2>
      <div class="w-24 h-1 bg-sky-500 mx-auto rounded-full"></div>
    </div>

    <!-- Experience Grid -->
    <div class="max-w-4xl mx-auto grid gap-6">
      {experience.items.map((exp) => (
        <ExperienceCard {...exp} />
      ))}
    </div>
  </div>
</section>
