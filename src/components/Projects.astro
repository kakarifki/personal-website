---
import ProjectCard from './ProjectCard.astro';
import { SITE_CONFIG } from '../data/config';
const { projects } = SITE_CONFIG;
---

<section id="projects" class="py-24 relative bg-slate-950">
  <div class="container mx-auto px-4 relative z-10">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white" set:html={projects.title}></h2>
      <div class="w-24 h-1 bg-sky-500 mx-auto rounded-full mb-4"></div>
      <p class="text-gray-400 max-w-xl mx-auto">
        {projects.description}
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.items.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </div>
</section>
