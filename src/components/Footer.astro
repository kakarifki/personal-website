---
import { SITE_CONFIG } from '../data/config';
const socialLinks = SITE_CONFIG.socialLinks;
---

<footer class="py-12 bg-slate-950 border-t border-slate-800">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo -->
      <div class="text-center md:text-left">
        <a href="#home" class="text-2xl font-bold text-white hover:text-sky-500 transition-colors">
          {SITE_CONFIG.author}
        </a>
        <p class="text-gray-500 text-sm mt-1">{SITE_CONFIG.role}</p>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : "_blank"}
            rel="noopener noreferrer"
            aria-label={link.label}
            class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-900 border border-slate-800 text-gray-400 hover:text-white hover:border-sky-500 transition-all duration-300"
          >
            <i class={`${link.icon} text-lg`}></i>
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <p class="text-gray-500 text-sm">
        &copy; {SITE_CONFIG.copyrightYear} {SITE_CONFIG.author}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
